{
  "goal": "写一份 notes.md：内容一行「数完了」。",
  "maxSteps": 4,
  "assertions": [
    { "name": "文件在", "action": "ok", "argv": ["/bin/sh", "-c", "test -f notes.md"] },
    { "name": "内容对", "action": "ok", "argv": ["/bin/sh", "-c", "grep -q 数完了 notes.md"] }
  ],
  "split": [
    {
      "goal": "写一份 notes.md（内容一行：数完了）。",
      "ownedPaths": ["notes.md"],
      "deliverables": [{ "path": "notes.md", "form": "一份文件" }],
      "assertions": [{ "name": "文件在", "action": "ok" }, { "name": "内容对", "action": "ok" }]
    }
  ],
  "base": [
    {
      "path": "AGENTS.md",
      "text": "# 项目方针\n\n- 这个仓库很小：只有这一份文件，加上你要写的 `notes.md`。\n- 交付物写在仓库根上；要核自己刚写的东西就直接 `cat` 它。\n- 不要列目录、不要看时间戳、不要 `pwd`——这个工作区没有别的可看。\n"
    }
  ],
  "expected": { "notes.md": "数完了\n" }
}
