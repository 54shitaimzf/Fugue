index 0000000..0a44c66
--- /dev/null
+++ b/src/truth/tree-name-index.ts
@@ -0,0 +1,69 @@
+// Private derived lookup over complete, privately parsed immutable tree arrays.
+export const MAX_NAME_INDEX_TREES = 256
+export const MAX_NAME_INDEX_ROWS = 32768
+export const MAX_NAME_INDEX_UNITS = 1024 * 1024
+export const MAX_NAME_INDEX_BYTES = 4 * 1024 * 1024
+
+interface Named { readonly name: string }
+interface Indexed<T> {
+  readonly rows: readonly T[]
+  readonly names: ReadonlyMap<string, T>
+  readonly units: number
+  readonly bytes: number
+}
+
+/** No caller options or Truth contract changes. Rejected trees retain Array.find. */
+export class TreeNameIndex<T extends Named> {
+  private readonly trees = new Map<string, Indexed<T>>()
+  private rows = 0
+  private units = 0
+  private bytes = 0
+
+  private remove(key: string, indexed: Indexed<T>): void {
+    this.trees.delete(key)
+    this.rows -= indexed.rows.length
+    this.units -= indexed.units
+    this.bytes -= indexed.bytes
+  }
+
+  find(key: string, rows: readonly T[], name: string): T | undefined {
+    const found = this.trees.get(key)
+    if (found !== undefined) {
+      if (found.rows === rows) {
+        this.trees.delete(key); this.trees.set(key, found)
+        return found.names.get(name)
+      }
+      this.remove(key, found)
+    }
+    // Charge all rows/names before allocating a Map, including duplicate names.
+    // Production arrays and their primitive fields never escape Truth's parser.
+    if (rows.length > MAX_NAME_INDEX_ROWS) return rows.find(row => row.name === name)
+    let units = 0
+    for (const row of rows) {
+      units += row.name.length
+      if (units > MAX_NAME_INDEX_UNITS) return rows.find(row => row.name === name)
+    }
+    const bytes = 128 + key.length * 2 + rows.length * 64 + units * 2
+    if (bytes > MAX_NAME_INDEX_BYTES) return rows.find(row => row.name === name)
+    // Release old retained indexes before allocating the next admitted Map.
+    while (this.trees.size >= MAX_NAME_INDEX_TREES || this.rows + rows.length > MAX_NAME_INDEX_ROWS ||
+      this.units + units > MAX_NAME_INDEX_UNITS || this.bytes + bytes > MAX_NAME_INDEX_BYTES) {
+      const oldest = this.trees.entries().next().value!
+      this.remove(oldest[0], oldest[1])
+    }
+    const names = new Map<string, T>()
+    for (const row of rows) {
+      // Array.find selects FIRST, even for duplicate or UTF-8-decoded alias names.
+      if (!names.has(row.name)) names.set(row.name, row)
+    }
+    const indexed = { rows, names, units, bytes }
+    this.trees.set(key, indexed)
+    this.rows += rows.length; this.units += units; this.bytes += bytes
+    return names.get(name)
+  }
+
+  clear(): void {
+    this.trees.clear()
+    this.rows = 0; this.units = 0; this.bytes = 0
+  }
+}
