+++ b/src/truth/tree-name-index.test.ts
@@ -0,0 +1,86 @@
+import assert from 'node:assert/strict'
+import { test } from 'node:test'
+import { TreeNameIndex, MAX_NAME_INDEX_TREES, MAX_NAME_INDEX_ROWS, MAX_NAME_INDEX_UNITS } from './tree-name-index.ts'
+
+function tracked(count: number, name: (at: number) => string = at => `row-${at}`) {
+  let reads = 0
+  const rows = Array.from({ length: count }, (_, at) => ({ get name() { reads++; return name(at) }, at }))
+  return { rows, reads: () => reads }
+}
+
+test('complete name indexes preserve first duplicates and exact decoded-string identity', () => {
+  const cache = new TreeNameIndex<{ name: string; mode: number; id: string }>()
+  const rows = [{ name: 'same', mode: 0o100644, id: 'first' }, { name: 'same', mode: 0o40000, id: 'second' },
+    { name: '__proto__', mode: 0o120000, id: 'link' }, { name: '�', mode: 0o100644, id: 'first decoded alias' },
+    { name: '�', mode: 0o100755, id: 'second decoded alias' }]
+  for (const name of ['same', '__proto__', '�', 'absent']) assert.equal(cache.find('tree', rows, name), rows.find(row => row.name === name))
+  assert.equal(cache.find('tree', rows, 'same'), rows[0])
+})
+
+test('warm indexes avoid linear name inspection and changed array identity never reuses stale rows', () => {
+  const rows = tracked(512), cache = new TreeNameIndex<{ name: string; at: number }>()
+  assert.equal(cache.find('tree', rows.rows, 'row-511'), rows.rows[511])
+  const built = rows.reads()
+  for (let at = 0; at < 512; at++) assert.equal(cache.find('tree', rows.rows, `row-${at}`), rows.rows[at])
+  assert.equal(cache.find('tree', rows.rows, 'absent'), undefined)
+  assert.equal(rows.reads(), built)
+  const replacement = [{ name: 'other', at: 0 }]
+  assert.equal(cache.find('tree', replacement, 'row-511'), undefined)
+  assert.equal(cache.find('tree', replacement, 'other'), replacement[0])
+  cache.clear()
+  cache.find('tree', rows.rows, 'row-511')
+  assert.ok(rows.reads() > built)
+})
+
+test('tree-count LRU is bounded and promotes actual lookups', () => {
+  const rows = Array.from({ length: MAX_NAME_INDEX_TREES + 1 }, () => tracked(1))
+  const cache = new TreeNameIndex<{ name: string; at: number }>()
+  for (let at = 0; at < MAX_NAME_INDEX_TREES; at++) cache.find(`tree-${at}`, rows[at]!.rows, 'row-0')
+  const first = rows[0]!.reads(), second = rows[1]!.reads()
+  cache.find('tree-0', rows[0]!.rows, 'row-0')
+  cache.find('new', rows[MAX_NAME_INDEX_TREES]!.rows, 'row-0')
+  cache.find('tree-0', rows[0]!.rows, 'row-0')
+  assert.equal(rows[0]!.reads(), first)
+  cache.find('tree-1', rows[1]!.rows, 'row-0')
+  assert.ok(rows[1]!.reads() > second)
+})
+
+test('row/name and accounted-byte admission boundaries retain linear fallback', () => {
+  const cache = new TreeNameIndex<{ name: string; at: number }>()
+  const atLimit = tracked(MAX_NAME_INDEX_ROWS)
+  cache.find('at-limit', atLimit.rows, 'row-0')
+  const admitted = atLimit.reads()
+  cache.find('at-limit', atLimit.rows, 'row-0')
+  assert.equal(atLimit.reads(), admitted)
+  const tooMany = tracked(MAX_NAME_INDEX_ROWS + 1)
+  assert.equal(cache.find('too-many', tooMany.rows, 'row-0'), tooMany.rows[0])
+  assert.equal(tooMany.reads(), 1, 'row budget refuses before building an index')
+  const tooLong = tracked(1, () => 'x'.repeat(MAX_NAME_INDEX_UNITS + 1))
+  cache.find('too-long', tooLong.rows, 'absent')
+  const rejected = tooLong.reads()
+  cache.find('too-long', tooLong.rows, 'absent')
+  assert.ok(tooLong.reads() > rejected)
+  const bytePressure = tracked(MAX_NAME_INDEX_ROWS, () => 'x'.repeat(32))
+  cache.find('byte-pressure', bytePressure.rows, 'absent')
+  const bytesRejected = bytePressure.reads()
+  cache.find('byte-pressure', bytePressure.rows, 'absent')
+  assert.ok(bytePressure.reads() > bytesRejected, 'independent byte accounting forces fallback')
+})
+
+test('global row/name budgets evict whole indexes without changing answers', () => {
+  const cache = new TreeNameIndex<{ name: string; at: number }>()
+  const first = tracked(MAX_NAME_INDEX_ROWS / 2), second = tracked(MAX_NAME_INDEX_ROWS / 2), extra = tracked(1)
+  cache.find('first', first.rows, 'row-0'); cache.find('second', second.rows, 'row-0')
+  const before = first.reads()
+  cache.find('extra', extra.rows, 'row-0')
+  assert.equal(cache.find('first', first.rows, 'row-0'), first.rows[0])
+  assert.ok(first.reads() > before)
+  cache.clear()
+  const huge = 'y'.repeat(MAX_NAME_INDEX_UNITS)
+  const largeFirst = tracked(1, () => huge), largeSecond = tracked(1, () => huge)
+  cache.find('large-first', largeFirst.rows, 'absent')
+  const named = largeFirst.reads()
+  cache.find('large-second', largeSecond.rows, 'absent')
+  cache.find('large-first', largeFirst.rows, 'absent')
+  assert.ok(largeFirst.reads() > named)
+})
